{
	"compilerOptions": {
		"target": "ES2022",
		"module": "preserve",
		"moduleResolution": "bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"declaration": true,
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"types": ["@cloudflare/workers-types"],
		"outDir": "./dist",
		"rootDir": "."
	},
	"include": ["src/**/*", "tests/**/*"],
	"exclude": ["node_modules", "dist"]
}
